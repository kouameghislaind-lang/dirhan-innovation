# Modèle des variables d'environnement du site DIRHAN INNOVATION.
#
# SUR TON ORDINATEUR :
#   1. Copie ce fichier et renomme la copie en ".env.local"
#   2. Remplis les valeurs ci-dessous
#   3. Redémarre le site (npm run dev)
#
# SUR VERCEL :
#   Projet > Settings > Environment Variables : ajoute les mêmes noms et valeurs.
#
# Ne partage JAMAIS le fichier .env.local : il contient ta clé secrète.
# Il est exclu de Git automatiquement (voir .gitignore).

# ----- Adresse du site (SEO) -----
# Ton nom de domaine définitif, sans "/" à la fin. Facultatif au début :
# sans cette valeur, Vercel fournit automatiquement l'adresse en .vercel.app.
NEXT_PUBLIC_SITE_URL=

# ----- Formulaire de contact (service Resend : https://resend.com) -----
# Clé secrète Resend (Resend > API Keys). Commence par "re_".
RESEND_API_KEY=

# Adresse qui recevra les messages du formulaire.
# En mode test Resend (sans domaine vérifié), ce doit être l'adresse de ton compte Resend.
CONTACT_EMAIL_DESTINATION=

# (Facultatif) Expéditeur affiché. Par défaut : onboarding@resend.dev (mode test Resend).
# Une fois ton domaine vérifié chez Resend, mets par exemple :
# CONTACT_EMAIL_EXPEDITEUR=Site DIRHAN <contact@ton-domaine.com>
CONTACT_EMAIL_EXPEDITEUR=
